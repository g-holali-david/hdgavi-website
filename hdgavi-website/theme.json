{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "custom": true,
      "defaultPalette": false,
      "palette": [
        { "slug": "paper", "color": "#F8F7F3", "name": "Paper" },
        { "slug": "ink", "color": "#1C1C1A", "name": "Ink" },
        { "slug": "ink-2", "color": "#46453F", "name": "Ink, secondary" },
        { "slug": "rule", "color": "#DAD7CF", "name": "Rule" },
        { "slug": "accent", "color": "#2A5878", "name": "Steel blue (CV)" },
        { "slug": "blue-grey", "color": "#DFE6EB", "name": "Blue grey (CV)" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "\"IBM Plex Sans\", \"Helvetica Neue\", Arial, sans-serif", "slug": "plex-sans", "name": "IBM Plex Sans" },
        { "fontFamily": "\"IBM Plex Serif\", Georgia, serif", "slug": "plex-serif", "name": "IBM Plex Serif" },
        { "fontFamily": "\"IBM Plex Mono\", ui-monospace, Menlo, Consolas, monospace", "slug": "plex-mono", "name": "IBM Plex Mono" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1.0625rem", "name": "Medium" },
        { "slug": "large", "size": "1.375rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "name": "Extra Large" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw"]
    },
    "layout": {
      "contentSize": "672px",
      "wideSize": "1040px"
    }
  }
}
